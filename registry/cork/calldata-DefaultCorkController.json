    "display": {
        "formats": {
            "addToGlobalWhitelist(address[])": {
                "intent": "Add addresses to the global whitelist",
                "fields": [
                    {
                        "label": "Accounts",
                        "format": "addressName",
                        "params": {
                            "types": [
                                "wallet",
                                "eoa",
                                "contract"
                            ]
                        },
                        "path": "#.accounts.[]"
                    }
                ],
                "required": [
                    "#.accounts.[]"
                ]
            },
            "addToMarketWhitelist(bytes32,address[])": {
                "intent": "Add addresses to a market's whitelist",
                "fields": [
                    {
                        "label": "Market ID",
                        "format": "raw",
                        "path": "#.marketId"
                    },
                    {
                        "label": "Accounts",
                        "format": "addressName",
                        "params": {
                            "types": [
                                "eoa",
                                "wallet"
                            ]
                        },
                        "path": "#.accounts.[]"
                    }
                ],
                "required": [
                    "#.marketId",
                    "#.accounts.[]"
                ]
            },
            "createNewPool(((address,address,uint256,uint256,uint256,uint256,uint256,address),uint256,uint256,bool))": {
                "intent": "Create a new market",
                "fields": [
                    {
                        "path": "#.params",
                        "fields": [
                            {
                                "path": "pool",
                                "fields": [
                                    {
                                        "label": "Collateral asset",
                                        "format": "addressName",
                                        "params": {
                                            "types": [
                                                "token"
                                            ]
                                        },
                                        "path": "collateralAsset"
                                    },
                                    {
                                        "label": "Reference asset",
                                        "format": "addressName",
                                        "params": {
                                            "types": [
                                                "token"
                                            ]
                                        },
                                        "path": "referenceAsset"
                                    },
                                    {
                                        "label": "Expiry timestamp",
                                        "format": "date",
                                        "params": {
                                            "encoding": "timestamp"
                                        },
                                        "path": "expiryTimestamp"
                                    },
                                    {
                                        "label": "Lower rate cap",
                                        "format": "raw",
                                        "path": "rateMin"
                                    },
                                    {
                                        "label": "Upper rate cap",
                                        "format": "raw",
                                        "path": "rateMax"
                                    },
                                    {
                                        "label": "Daily rate change allowed",
                                        "format": "raw",
                                        "path": "rateChangePerDayMax"
                                    },
                                    {
                                        "label": "Maximum one-time rate change",
                                        "format": "raw",
                                        "path": "rateChangeCapacityMax"
                                    },
                                    {
                                        "label": "Rate oracle address",
                                        "format": "addressName",
                                        "params": {
                                            "types": [
                                                "contract"
                                            ]
                                        },
                                        "path": "rateOracle"
                                    }
                                ]
                            },
                            {
                                "label": "Repurchase fee percentage",
                                "format": "raw",
                                "path": "unwindSwapFeePercentage"
                            },
                            {
                                "label": "Swap and exercise fee percentage",
                                "format": "raw",
                                "path": "swapFeePercentage"
                            },
                            {
                                "label": "Enable whitelist",
                                "format": "raw",
                                "path": "isWhitelistEnabled"
                            }
                        ]
                    }
                ],
                "required": [
                    "#.params.pool.collateralAsset",
                    "#.params.pool.referenceAsset",
                    "#.params.pool.expiryTimestamp",
                    "#.params.pool.rateMin",
                    "#.params.pool.rateMax",
                    "#.params.pool.rateChangePerDayMax",
                    "#.params.pool.rateChangeCapacityMax",
                    "#.params.pool.rateOracle",
                    "#.params.unwindSwapFeePercentage",
                    "#.params.swapFeePercentage",
                    "#.params.isWhitelistEnabled"
                ]
            },
            "disableMarketWhitelist(bytes32)": {
                "intent": "Disable market whitelist",
