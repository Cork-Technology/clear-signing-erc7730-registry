{
    "$schema": "../../specs/erc7730-v1.schema.json",
    "context": {
        "$id": "OpenZeppelin TimelockController",
        "contract": {
            "abi": [
                { "type": "function", "name": "cancel", "inputs": [{"name":"id","type":"bytes32"}], "outputs": [], "stateMutability": "nonpayable" },
                { "type": "function", "name": "execute", "inputs": [{"name":"target","type":"address"},{"name":"value","type":"uint256"},{"name":"payload","type":"bytes"},{"name":"predecessor","type":"bytes32"},{"name":"salt","type":"bytes32"}], "outputs": [], "stateMutability": "payable" },
                { "type": "function", "name": "executeBatch", "inputs": [{"name":"targets","type":"address[]"},{"name":"values","type":"uint256[]"},{"name":"payloads","type":"bytes[]"},{"name":"predecessor","type":"bytes32"},{"name":"salt","type":"bytes32"}], "outputs": [], "stateMutability": "payable" },
                { "type": "function", "name": "schedule", "inputs": [{"name":"target","type":"address"},{"name":"value","type":"uint256"},{"name":"data","type":"bytes"},{"name":"predecessor","type":"bytes32"},{"name":"salt","type":"bytes32"},{"name":"delay","type":"uint256"}], "outputs": [], "stateMutability": "nonpayable" },
                { "type": "function", "name": "scheduleBatch", "inputs": [{"name":"targets","type":"address[]"},{"name":"values","type":"uint256[]"},{"name":"payloads","type":"bytes[]"},{"name":"predecessor","type":"bytes32"},{"name":"salt","type":"bytes32"},{"name":"delay","type":"uint256"}], "outputs": [], "stateMutability": "nonpayable" },
                { "type": "function", "name": "updateDelay", "inputs": [{"name":"newDelay","type":"uint256"}], "outputs": [], "stateMutability": "nonpayable" },
                { "type": "function", "name": "grantRole", "inputs": [{"name":"role","type":"bytes32"},{"name":"account","type":"address"}], "outputs": [], "stateMutability": "nonpayable" },
                { "type": "function", "name": "revokeRole", "inputs": [{"name":"role","type":"bytes32"},{"name":"account","type":"address"}], "outputs": [], "stateMutability": "nonpayable" },
                { "type": "function", "name": "renounceRole", "inputs": [{"name":"role","type":"bytes32"},{"name":"callerConfirmation","type":"address"}], "outputs": [], "stateMutability": "nonpayable" }
            ]
        }
    },
    "metadata": { "owner": "OpenZeppelin" },
    "display": {
        "formats": {
            "cancel(bytes32)": {
                "intent": "Cancel operation",
                "fields": [{ "label": "ID", "format": "raw", "path": "#.id" }],
                "required": ["#.id"]
            },
            "execute(address,uint256,bytes,bytes32,bytes32)": {
                "intent": "Execute operation",
                "fields": [
                    { "label": "Target", "format": "addressName", "params": { "types": ["wallet","eoa","contract","token","collection"] }, "path": "#.target" },
                    { "label": "Value", "format": "amount", "path": "#.value" },
                    { "label": "Payload", "format": "calldata", "params": { "calleePath": "#.target" }, "path": "#.payload" },
                    { "label": "Predecessor", "format": "raw", "path": "#.predecessor" },
                    { "label": "Salt", "format": "raw", "path": "#.salt" }
                ],
                "required": ["#.target","#.value","#.payload","#.predecessor","#.salt"],
                "excluded": ["#.payload.[]"]
            },
            "executeBatch(address[],uint256[],bytes[],bytes32,bytes32)": {
                "intent": "Execute batch operations",
                "fields": [
                    { "label": "Targets", "format": "addressName", "params": { "types": ["wallet","eoa","contract","token","collection"] }, "path": "#.targets.[]" },
                    { "label": "Values", "format": "amount", "path": "#.values.[]" },
                    { "label": "Payloads", "format": "calldata", "params": { "calleePath": "#.targets.[]" }, "path": "#.payloads.[]" },
                    { "label": "Predecessor", "format": "raw", "path": "#.predecessor" },
                    { "label": "Salt", "format": "raw", "path": "#.salt" }
                ],
                "required": ["#.targets.[]","#.values.[]","#.payloads.[]","#.predecessor","#.salt"]
            },
            "schedule(address,uint256,bytes,bytes32,bytes32,uint256)": {
                "intent": "Schedule operation",
                "fields": [
                    { "label": "Target", "format": "addressName", "params": { "types": ["wallet","eoa","contract","token","collection"] }, "path": "#.target" },
                    { "label": "Value", "format": "amount", "path": "#.value" },
                    { "label": "Data", "format": "calldata", "params": { "calleePath": "#.target" }, "path": "#.data" },
                    { "label": "Predecessor", "format": "raw", "path": "#.predecessor" },
                    { "label": "Salt", "format": "raw", "path": "#.salt" },
                    { "label": "Delay", "format": "raw", "path": "#.delay" }
                ],
                "required": ["#.target","#.value","#.data","#.predecessor","#.salt","#.delay"],
                "excluded": ["#.data.[]"]
            },
            "scheduleBatch(address[],uint256[],bytes[],bytes32,bytes32,uint256)": {
                "intent": "Schedule batch operations",
                "fields": [
                    { "label": "Targets", "format": "addressName", "params": { "types": ["wallet","eoa","contract","token","collection"] }, "path": "#.targets.[]" },
                    { "label": "Values", "format": "amount", "path": "#.values.[]" },
                    { "label": "Payloads", "format": "calldata", "params": { "calleePath": "#.targets.[]" }, "path": "#.payloads.[]" },
                    { "label": "Predecessor", "format": "raw", "path": "#.predecessor" },
                    { "label": "Salt", "format": "raw", "path": "#.salt" },
                    { "label": "Delay", "format": "raw", "path": "#.delay" }
                ],
                "required": ["#.targets.[]","#.values.[]","#.payloads.[]","#.predecessor","#.salt","#.delay"]
            },
            "updateDelay(uint256)": {
                "intent": "Update execution delay",
                "fields": [{ "label": "New delay", "format": "raw", "path": "#.newDelay" }],
                "required": ["#.newDelay"]
            },
            "grantRole(bytes32,address)": {
                "intent": "Grant role",
                "fields": [
                    { "label": "Role", "format": "raw", "path": "#.role" },
                    { "label": "Account", "format": "addressName", "params": { "types": ["eoa","wallet"] }, "path": "#.account" }
                ],
                "required": ["#.role","#.account"]
            },
            "revokeRole(bytes32,address)": {
                "intent": "Revoke role",
                "fields": [
                    { "label": "Role", "format": "raw", "path": "#.role" },
                    { "label": "Account", "format": "addressName", "params": { "types": ["eoa","wallet"] }, "path": "#.account" }
                ],
                "required": ["#.role","#.account"]
            },
            "renounceRole(bytes32,address)": {
                "intent": "Renounce role",
                "fields": [
                    { "label": "Role", "format": "raw", "path": "#.role" },
                    { "label": "Caller confirmation", "format": "addressName", "params": { "types": ["wallet","eoa","contract","token","collection"] }, "path": "#.callerConfirmation" }
                ],
                "required": ["#.role","#.callerConfirmation"]
            }
        }
    }
}
