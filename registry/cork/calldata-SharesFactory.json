{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "includes": "common-ownership.json",
  "context": {
    "$id": "SharesFactory",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0xcCCCccCCCcCc1782617fe14A386AC910a20D4324"
        }
      ],
      "abi": [
        {
          "type": "function",
          "name": "CORK_POOL_MANAGER",
