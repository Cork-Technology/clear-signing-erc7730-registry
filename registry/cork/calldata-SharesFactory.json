              "internalType": "address"
            }
          ],
          "stateMutability": "view"
        },
        {
          "type": "function",
          "name": "deployPoolShares",
          "inputs": [
            {
              "name": "params",
              "type": "tuple",
              "internalType": "struct ISharesFactory.DeployParams",
              "components": [
                {
                  "name": "poolParams",
                  "type": "tuple",
                  "internalType": "struct Market",
                  "components": [
                    {
                      "name": "collateralAsset",
                      "type": "address",
                      "internalType": "address"
                    },
                    {
                      "name": "referenceAsset",
                      "type": "address",
                      "internalType": "address"
                    },
                    {
                      "name": "expiryTimestamp",
                      "type": "uint256",
                      "internalType": "uint256"
                    },
                    {
                      "name": "rateMin",
                      "type": "uint256",
                      "internalType": "uint256"
                    },
                    {
                      "name": "rateMax",
                      "type": "uint256",
                      "internalType": "uint256"
                    },
                    {
                      "name": "rateChangePerDayMax",
                      "type": "uint256",
                      "internalType": "uint256"
                    },
                    {
                      "name": "rateChangeCapacityMax",
                      "type": "uint256",
                      "internalType": "uint256"
                    },
                    {
                      "name": "rateOracle",
                      "type": "address",
                      "internalType": "address"
                    }
                  ]
                },
                {
                  "name": "poolId",
                  "type": "bytes32",
                  "internalType": "MarketId"
                }
              ]
            }
          ],
          "outputs": [
            {
              "name": "principalToken",
              "type": "address",
              "internalType": "address"
            },
            {
              "name": "swapToken",
              "type": "address",
              "internalType": "address"
            }
          ],
          "stateMutability": "nonpayable"
        },
        {
          "type": "function",
          "name": "owner",
          "inputs": [],
          "outputs": [
            {
              "name": "",
              "type": "address",
              "internalType": "address"
            }
          ],
          "stateMutability": "view"
        },
        {
          "type": "function",
          "name": "renounceOwnership",
          "inputs": [],
          "outputs": [],
          "stateMutability": "nonpayable"
        },
        {
          "type": "function",
          "name": "transferOwnership",
          "inputs": [
            {
              "name": "newOwner",
              "type": "address",
              "internalType": "address"
            }
          ],
          "outputs": [],
          "stateMutability": "nonpayable"
        }
      ]
    }
