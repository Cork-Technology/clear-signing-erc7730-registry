  "metadata": {
    "owner": "Cork Protocol",
    "contractName": "Shares Factory",
    "info": {
      "url": "https://www.cork.tech/"
    }
  },
  "display": {
    "formats": {
      "deployPoolShares(tuple(address,address,uint256,uint256,uint256,uint256,uint256,address) poolParams, bytes32 poolId)": {
        "$id": "deployPoolShares",
        "intent": "Deploy pool share tokens",
        "fields": [
          {
            "path": "poolParams.collateralAsset",
            "label": "Collateral asset",
            "format": "addressName",
            "params": {
              "types": [
                "token"
              ]
            },
            "visible": "always"
          },
          {
            "path": "poolParams.referenceAsset",
            "label": "Reference asset",
            "format": "addressName",
            "params": {
              "types": [
                "token"
              ]
            },
            "visible": "always"
          },
          {
            "path": "poolParams.expiryTimestamp",
            "label": "Expiry",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            },
            "visible": "always"
          },
          {
            "path": "poolParams.rateMin",
            "label": "Rate floor",
            "format": "unit",
            "params": {
              "base": "",
              "decimals": 18
            },
            "visible": "always"
          },
          {
            "path": "poolParams.rateMax",
            "label": "Rate ceiling",
            "format": "unit",
            "params": {
              "base": "",
              "decimals": 18
            },
            "visible": "always"
          },
          {
            "path": "poolParams.rateChangePerDayMax",
            "label": "Daily rate cap",
            "format": "unit",
            "params": {
              "base": "",
              "decimals": 18
            },
            "visible": "always"
          },
          {
            "path": "poolParams.rateChangeCapacityMax",
            "label": "Burst rate cap",
            "format": "unit",
            "params": {
              "base": "",
              "decimals": 18
            },
            "visible": "always"
          },
          {
            "path": "poolParams.rateOracle",
            "label": "Rate oracle",
            "format": "addressName",
            "params": {
              "types": [
                "contract"
              ]
            },
            "visible": "always"
          },
          {
            "path": "poolId",
            "label": "Pool ID",
            "format": "raw",
            "visible": "always"
          }
        ]
      }
    }
  }
